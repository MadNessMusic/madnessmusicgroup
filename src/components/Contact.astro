


<!-- HEADER LINE -->
<div class="mx-auto px-6 mb-20 reveal">
  <div class="flex items-center gap-10">
    <span class="block w-30 h-px bg-base-content/30"></span>
    <span class="text-2xl tracking-[0.7em] uppercase opacity-30">
      Contacto
    </span>
    <span class="flex-1 h-px bg-base-content/30"></span>
  </div>
</div>

<section id="contact" class="reveal mx-auto scroll py-10 mb-10 px-6">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
    <div>
 <h2 class="font-anton text-3xl md:text-5xl tracking-wide mb-10">
  Conectemos
</h2>

<p class="text-base md:text-lg text-base-content/70 leading-relaxed mb-8 max-w-md">
  Colaboraciones, propuestas editoriales o proyectos especiales. 
  Cuéntanos qué tienes en mente.
</p>

      <div class="flex gap-4 mt-2">
        <a
          href="https://mail.google.com/mail/?view=cm&to=contact@madnessmusicgroup.com"
          target="_blank"
          class="btn-tactical"
        >
          Correo
        </a>

        <a
          href="https://wa.me/528442564688?text=Hola%20MadNess%20Music%20Group"
          target="_blank"
          class="btn-tactical"
        >
          WhatsApp
        </a>
      </div>
    </div>

    <form
      id="contactForm"
      class="flex flex-col gap-2"
    >
      <input type="hidden" name="form-name" value="contact" />

      <p class="hidden">
        <label>
          Do not fill this out:
          <input name="bot-field" />
        </label>
      </p>

      <label
        for="name"
        class="text-xs uppercase tracking-widest text-base-content/50 mb-2 block"
      >
        ¿Cuál es tu nombre?
      </label>

<input
  id="name"
  name="name"
  type="text"
  placeholder="Nombre completo"
  required
  class="
    w-full
    bg-transparent
    border-b border-base-content/30
    py-3 mb-10
    text-base-content
    placeholder:text-base-content/40
    focus:outline-none
    focus:border-accent
    transition-all duration-300
  "
/>
      <label
        for="email"
        class="text-xs uppercase tracking-widest text-base-content/50 mb-2 block"
      >
        ¿Cuál es tu correo?
      </label>

<input
  id="email"
  name="email"
  type="email"
  placeholder="Correo electrónico"
  required
  class="
    w-full
    bg-transparent
    border-b border-base-content/30
    py-3 mb-10
    text-base-content
    placeholder:text-base-content/40
    focus:outline-none
    focus:border-accent
    transition-all duration-300
  "
/>

      <label
        for="message"
        class="text-xs uppercase tracking-widest opacity-50"
      >
        Cuéntanos en qué podemos ayudarte
      </label>

<textarea
  required
  id="message"
  name="message"
  rows="4"
  placeholder="Mensaje"
  class="
    w-full
    bg-transparent
    border-b border-base-content/30
    py-3
    text-base-content
    placeholder:text-base-content/40
    focus:outline-none
    focus:border-accent
    transition-all duration-300
    resize-none
  "
></textarea>

<label class="text-xs opacity-60 flex gap-2 mt-4 items-start">
  <input type="checkbox" required class="mt-1" />

  <span>
    Acepto los 
    <a href="/terminos" target="_blank" class="underline hover:text-accent">
      términos y condiciones
    </a>
    y el 
    <a href="/privacidad" target="_blank" class="underline hover:text-accent">
      aviso de privacidad
    </a>
  </span>
</label>


<button
  type="submit"
  class="
    btn-tactical
    self-start
    flex items-center gap-3
    mt-8
    px-6 py-3
    hover:scale-[1.02]
    transition-all
  "
>
        <span class="btn-text">
          Enviar mensaje
        </span>

        <span
          class="btn-loader hidden w-4 h-4 border-2 border-base-content/30 border-t-white rounded-full animate-spin"
        ></span>
      </button>
    </form>
  </div>
</section>

<script>
  import "../scripts/contact.js";
</script>