<script is:inline>
  window.addEventListener("load", () => {
    const container = document.getElementById("presave-carousel");
    const next = document.getElementById("next-presave");
    const prev = document.getElementById("prev-presave");

    if (!container) return;

    let animationId;
    let speed = 0.4;
    let originalWidth = 0;
    let isPaused = false;

    function calculate() {
      originalWidth = container.scrollWidth / 2;
    }

    function loop() {
      if (!isPaused) {
        container.scrollLeft += speed;

        if (container.scrollLeft >= originalWidth) {
          container.scrollLeft -= originalWidth;
        }
      }

      animationId = requestAnimationFrame(loop);
    }

    function start() {
      cancelAnimationFrame(animationId);
      isPaused = false;
      loop();
    }

    function stop() {
      isPaused = true;
    }

    // 🔥 INIT (espera real)
    setTimeout(() => {
      calculate();
      start();
    }, 600);

    // 🎯 botones
    if (next && prev) {
      next.addEventListener("click", () => {
        stop();
        container.scrollBy({ left: 320, behavior: "smooth" });
        setTimeout(start, 800);
      });

      prev.addEventListener("click", () => {
        stop();
        container.scrollBy({ left: -320, behavior: "smooth" });
        setTimeout(start, 800);
      });
    }

    // 🧠 UX
    container.addEventListener("mouseenter", stop);
    container.addEventListener("mouseleave", start);

    container.addEventListener("touchstart", stop);
    container.addEventListener("touchend", start);

    window.addEventListener("resize", calculate);
  });
</script>

<script is:inline>
  const carousel = document.getElementById("presave-carousel");

  if (carousel) {
    let speed = 0.3;
    let isHovering = false;

    // 🖱 hover control
    carousel.addEventListener("mouseenter", () => {
      isHovering = true;
    });

    carousel.addEventListener("mouseleave", () => {
      isHovering = false;
    });

    function autoScroll() {
      // 🔥 solo se mueve si NO estás encima
      if (!isHovering) {
        carousel.scrollLeft += speed;
      }

      // 🔁 loop infinito real
      if (carousel.scrollLeft >= carousel.scrollWidth - carousel.clientWidth) {
        carousel.scrollLeft = 0;
      }

      requestAnimationFrame(autoScroll);
    }

    // 🚀 solo si hay suficientes items
    if (carousel.children.length > 3) {
      autoScroll();
    }
  }
</script>