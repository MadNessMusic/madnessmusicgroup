---
import DarkModeToggle from "./DarkModeToggle.astro";
import logoDark from "../assets/MadNess Music Group - Logo White.png";
import logoLight from "../assets/MadNess Music Group - Logo Black.png";
import { siteConfig } from "../data/siteConfig";

const pathname = Astro.url.pathname;

const minimalRoutes = ["/archive", "/playlists", "/gracias", "/submit"];

const minimalNavbar = minimalRoutes.some((route) =>
  pathname.startsWith(route)
);

const navLinks = minimalNavbar
  ? siteConfig.navLinks.slice(0, 1)
  : siteConfig.navLinks;
---

<header class="glass-nav w-full">
  <div class="max-w-350 mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
    
    <!-- LOGO -->
    <div class="flex items-center gap-5">
      <a href="/" class="flex items-center gap-5 group">
        <div class="logo-nav-wrap">
          <img src={logoDark.src} class="logo-nav logo-nav-dark" />
          <img src={logoLight.src} class="logo-nav logo-nav-light" />
        </div>
      </a>
    </div>

    <!-- DESKTOP NAV -->
    <nav class="hidden md:flex items-center gap-8 text-xs font-bold uppercase tracking-widest text-base-content">
      
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-section={link.href.replace("/#", "")}
          class="nav-link transition-colors hover:text-accent"
        >
          {link.label}
        </a>
      ))}

    </nav>

    <!-- RIGHT -->
    <div class="flex items-center gap-3">
      <DarkModeToggle />

      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 hover:bg-base-200 transition-colors rounded-lg"
        aria-label="Open menu"
        aria-expanded="false"
      >
        ☰
      </button>
    </div>
  </div>

  <!-- MOBILE MENU -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden border-t border-base-content/10 bg-base-100/95 backdrop-blur-md transition-all duration-300 max-h-0"
  >
    <nav class="flex flex-col py-4 px-4 sm:px-6 space-y-3 text-xs font-bold uppercase tracking-widest">
      
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-section={link.href.replace("/#", "")}
          class="nav-link py-2 transition-colors hover:text-accent"
        >
          {link.label}
        </a>
      ))}

    </nav>
  </div>
</header>

<script is:inline>
  // =========================
  // MOBILE MENU
  // =========================
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuBtn && mobileMenu) {
    let open = false;

    menuBtn.addEventListener("click", () => {
      open = !open;

      menuBtn.setAttribute("aria-expanded", String(open));

      mobileMenu.style.maxHeight = open
        ? mobileMenu.scrollHeight + "px"
        : "0px";
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        open = false;
        mobileMenu.style.maxHeight = "0px";
        menuBtn.setAttribute("aria-expanded", "false");
      });
    });
  }

  // =========================
  // ACTIVE LINK (SCROLL)
  // =========================
  const sections = document.querySelectorAll("[id]");
  const navItems = document.querySelectorAll(".nav-link");

 function setActiveLink() {
  let current = "";

  const scrollY = window.scrollY;

  sections.forEach((section) => {
    const offset = section.offsetTop - 150;
    const height = section.offsetHeight;

    if (scrollY >= offset && scrollY < offset + height) {
      current = section.id;
    }
  });

  navItems.forEach((link) => {
    const section = link.dataset.section;

    if (section === current) {
      link.classList.add("text-accent");
    } else {
      link.classList.remove("text-accent");
    }
  });
}

  window.addEventListener("scroll", setActiveLink);
  window.addEventListener("load", setActiveLink);
</script>