---
import DarkModeToggle from "./DarkModeToggle.astro";
import logoDark from "../assets/MadNess Music Group - Logo White.png";
import logoLight from "../assets/MadNess Music Group - Logo Black.png";
import { siteConfig } from "../data/siteConfig";

const pathname = Astro.url.pathname;

const minimalNavbar =
  pathname.startsWith("/archive") ||
  pathname.startsWith("/playlists");

const navLinks = minimalNavbar
  ? siteConfig.navLinks.filter((l) => l.href === "/")
  : siteConfig.navLinks;
---

<header class="glass-nav w-full">
  <div class="max-w-350 mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
    
    <!-- LOGO -->
    <a href="/" class="flex items-center gap-5 group">
      <div class="logo-nav-wrap">
        <img src={logoDark.src} class="logo-nav logo-nav-dark" />
        <img src={logoLight.src} class="logo-nav logo-nav-light" />
      </div>
    </a>

    <!-- DESKTOP NAV -->
    <nav class="hidden md:flex items-center gap-8 text-xs font-bold uppercase tracking-widest text-white/90">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`transition-colors ${
            Astro.url.href.includes(link.href)
              ? "text-accent"
              : "hover:text-accent text-white/70"
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- RIGHT SIDE -->
    <div class="flex items-center gap-3">
      <DarkModeToggle />

      <!-- MOBILE BUTTON -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 hover:bg-base-200 transition-colors rounded-lg"
        aria-label="Open menu"
        aria-expanded="false"
      >
        ☰
      </button>
    </div>
  </div>

  <!-- MOBILE MENU -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden border-t border-white/10 bg-black/90 backdrop-blur-xl transition-all duration-300 max-h-0"
  >
    <nav class="flex flex-col py-4 px-4 space-y-3 text-xs font-bold uppercase tracking-widest text-white">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`py-2 transition-colors ${
            Astro.url.href.includes(link.href)
              ? "text-accent"
              : "hover:text-accent"
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuBtn && mobileMenu) {
    let open = false;

    menuBtn.addEventListener("click", () => {
      open = !open;

      menuBtn.setAttribute("aria-expanded", String(open));

      if (open) {
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
      } else {
        mobileMenu.style.maxHeight = "0px";
      }
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        open = false;
        mobileMenu.style.maxHeight = "0px";
        menuBtn.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>