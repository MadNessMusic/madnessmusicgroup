---

---

<div
  id="cookie-backdrop"
  class="fixed inset-0 z-998 backdrop-blur-lg bg-black/40 opacity-0 pointer-events-none transition-all duration-500"
></div>

<div
  id="cookie-banner"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 w-[92%] max-w-2xl z-999 hidden opacity-0 translate-y-10 pointer-events-none transition-all duration-700"
>
  <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black/80 backdrop-blur-2xl p-6 shadow-2xl">

    <!-- glow -->
    <div class="absolute inset-0 opacity-20 bg-linear-to-r from-accent via-transparent to-accent blur-2xl"></div>

    <div class="relative flex flex-col md:flex-row items-start md:items-center gap-5">

      <!-- texto -->
      <p class="text-sm text-white/80 leading-relaxed max-w-lg">
        Utilizamos cookies para mejorar tu experiencia y analizar el uso del sitio.
        Consulta nuestro 
        <a href="/privacidad" class="underline hover:text-accent transition">
          aviso de privacidad
        </a>.
      </p>

      <!-- botones -->
      <div class="flex gap-3 ml-auto">
        <button
          id="cookie-decline"
          class="text-xs uppercase tracking-widest opacity-60 hover:opacity-100 transition"
        >
          Rechazar
        </button>

        <button
          id="cookie-accept"
          class="px-5 py-2 text-xs uppercase tracking-widest bg-white text-black rounded-lg hover:scale-105 transition"
        >
          Aceptar
        </button>
      </div>

    </div>
  </div>
</div>

<script is:inline>
  const banner = document.getElementById("cookie-banner");
  const acceptBtn = document.getElementById("cookie-accept");
  const declineBtn = document.getElementById("cookie-decline");
  const backdrop = document.getElementById("cookie-backdrop");

  const consent = localStorage.getItem("cookies-consent");

function showBanner() {
  banner.classList.remove("hidden");

  document.body.classList.add("no-scroll"); // 🔥 LOCK

  requestAnimationFrame(() => {
    banner.classList.remove("opacity-0", "translate-y-10", "pointer-events-none");
    banner.classList.add("opacity-100", "translate-y-0");

    backdrop.classList.remove("opacity-0", "pointer-events-none");
    backdrop.classList.add("opacity-100");
  });

  banner.animate(
    [
      { transform: "scale(0.98)", opacity: 0.8 },
      { transform: "scale(1.02)", opacity: 1 },
      { transform: "scale(1)" }
    ],
    { duration: 300, easing: "ease-out" }
  );
}

function hideBanner() {
  banner.animate(
    [
      { transform: "scale(1)", opacity: 1 },
      { transform: "scale(0.98)", opacity: 0 }
    ],
    { duration: 200, easing: "ease-in" }
  );

  backdrop.classList.remove("opacity-100");
  backdrop.classList.add("opacity-0");

  document.body.classList.remove("no-scroll"); // 🔥 UNLOCK

  setTimeout(() => {
    banner.classList.add("opacity-0", "translate-y-10", "pointer-events-none", "hidden");
    backdrop.classList.add("pointer-events-none");
  }, 200);
}

  // ✅ SOLO si no hay consentimiento
  if (!consent) {
    setTimeout(showBanner, 600);
  }

  acceptBtn?.addEventListener("click", () => {
    localStorage.setItem("cookies-consent", "accepted");
    hideBanner();
  });

  declineBtn?.addEventListener("click", () => {
    localStorage.setItem("cookies-consent", "declined");
    hideBanner();
  });
</script>