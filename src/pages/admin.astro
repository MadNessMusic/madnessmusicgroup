---
const password = "madness123"; // cámbialo
const url = new URL(Astro.request.url);
const isAuth = url.searchParams.get("key") === password;

if (!isAuth) {
  return Astro.redirect("/");
}
---

<section class="p-10 max-w-xl mx-auto">
  <h1 class="text-2xl mb-6">Admin Panel</h1>

  <form id="presave-form" class="space-y-4">
    <input id="title" placeholder="Title" class="input input-bordered w-full" />
    <input id="artist" placeholder="Artist" class="input input-bordered w-full" />
    <input id="url" placeholder="Presave URL" class="input input-bordered w-full" />
    <input id="image" placeholder="Image URL" class="input input-bordered w-full" />

    <select id="source" class="select select-bordered w-full">
      <option value="supported">Supported</option>
      <option value="madness">Madness</option>
    </select>

    <button class="btn btn-primary w-full">Subir Presave</button>
  </form>
</section>

<script>
const title = document.getElementById("title") as HTMLInputElement;
const artist = document.getElementById("artist") as HTMLInputElement;
const url = document.getElementById("url") as HTMLInputElement;
const image = document.getElementById("image") as HTMLInputElement;
const source = document.getElementById("source") as HTMLSelectElement;



document.getElementById("presave-form")!.addEventListener("submit", async (e) => {
  e.preventDefault();

  const data = {
    title: title.value,
    artist: artist.value,
    url: url.value,
    image: image.value,
    source: source.value
  };

  await fetch("/api/add-presave", {
    method: "POST",
    body: JSON.stringify(data)
  });

  alert("Presave agregado 🚀");
});
</script>