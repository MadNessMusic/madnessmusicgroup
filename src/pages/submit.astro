---
console.log("SUBMIT JS CARGADO 🚀");

import Layout from "@/layouts/Layout.astro"
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro"
---

<Layout />
<Navbar />


<section class="py-10 text-center max-w-2xl mx-auto px-6">

  <span class="block text-xs uppercase tracking-[0.5em] text-base-content/40 mb-6">
    Submit
  </span>

  <h1 class="font-heading text-5xl md:text-6xl mb-6 leading-tight">
    Enviar música
  </h1>

  <p class="text-base md:text-lg text-base-content/70 leading-relaxed">
    Seleccionamos proyectos con identidad. Si tu sonido encaja con nuestra línea, queremos escucharlo.
  </p>

</section>

<section class="max-w-4xl mx-auto px-6 flex flex-col gap-12">
<form
  id="submitForm"
  class="max-w-4xl mx-auto px-6 flex flex-col gap-12"
>

  <!-- 🧾 INFO -->
  <div>
    <label class="label">Nombre del artista</label>
    <input 
      name="artist" 
      required 
      class="input" 
      placeholder="Nombre artístico"
    />
  </div>

  <div>
    <label class="label">Correo</label>
    <input 
      type="email" 
      name="email" 
      required 
      class="input" 
      placeholder="correo@ejemplo.com (donde podamos contactarte)"
    />
  </div>

  <!-- 🎧 MÚSICA -->
<div>
  <label class="label">Link de Spotify</label>
  <input 
    id="spotifyInput"
    name="spotify" 
    required 
    type="url"
    pattern="https://open.spotify.com/.*"
    class="input" 
    placeholder="https://open.spotify.com/track/... o artist/..."
  />
</div>

<div class="form-section">

  <label class="label">Género (elige uno)</label>

<div class="chips" id="mainGenres">
  <button type="button" class="chip">Urbano</button>
  <button type="button" class="chip">Electrónico</button>
  <button type="button" class="chip">Indie</button>
  <button type="button" class="chip">Pop</button>
  <button type="button" class="chip">Experimental</button>
  <button type="button" class="chip">Hip-Hop</button>
  <button type="button" class="chip">R&B</button>
  <button type="button" class="chip">Rock</button>
  <button type="button" class="chip">Jazz</button>
  <button type="button" class="chip">Soul</button>
  <button type="button" class="chip">Afro</button>
  <button type="button" class="chip">Latino</button>
  <button type="button" class="chip">Club</button>
  <button type="button" class="chip">Ambient</button>
  <button type="button" class="chip">Folk</button>
  <button type="button" class="chip">Global</button>
</div>

</div>

<div class="form-section">

  <label class="label hidden-custom" id="subLabel">
    Subgénero (elige primero un género)
  </label>

<div class="chips hidden-custom" id="subGenres">

  <!-- URBANO -->
  <button type="button" class="chip sub" data-parent="Urbano">Reggaetón</button>
  <button type="button" class="chip sub" data-parent="Urbano">Trap</button>
  <button type="button" class="chip sub" data-parent="Urbano">Drill</button>
  <button type="button" class="chip sub" data-parent="Urbano">Jersey Club</button>
  <button type="button" class="chip sub" data-parent="Urbano">Dembow</button>

  <!-- ELECTRÓNICO -->
  <button type="button" class="chip sub" data-parent="Electrónico">House</button>
  <button type="button" class="chip sub" data-parent="Electrónico">Techno</button>
  <button type="button" class="chip sub" data-parent="Electrónico">Trance</button>
  <button type="button" class="chip sub" data-parent="Electrónico">Breakbeat</button>
  <button type="button" class="chip sub" data-parent="Electrónico">Garage</button>
  <button type="button" class="chip sub" data-parent="Electrónico">UK Bass</button>
  <button type="button" class="chip sub" data-parent="Electrónico">Drum & Bass</button>
  <button type="button" class="chip sub" data-parent="Electrónico">IDM</button>
  <button type="button" class="chip sub" data-parent="Electrónico">Hard Techno</button>
  <button type="button" class="chip sub" data-parent="Electrónico">Minimal</button>

  <!-- INDIE -->
  <button type="button" class="chip sub" data-parent="Indie">Alt Rock</button>
  <button type="button" class="chip sub" data-parent="Indie">Dream Pop</button>
  <button type="button" class="chip sub" data-parent="Indie">Lo-fi</button>
  <button type="button" class="chip sub" data-parent="Indie">Indie Folk</button>

  <!-- POP -->
  <button type="button" class="chip sub" data-parent="Pop">Alt Pop</button>
  <button type="button" class="chip sub" data-parent="Pop">Hyperpop</button>
  <button type="button" class="chip sub" data-parent="Pop">Synthpop</button>
  <button type="button" class="chip sub" data-parent="Pop">Dance Pop</button>

  <!-- EXPERIMENTAL -->
  <button type="button" class="chip sub" data-parent="Experimental">Noise</button>
  <button type="button" class="chip sub" data-parent="Experimental">Avant-garde</button>
  <button type="button" class="chip sub" data-parent="Experimental">Glitch</button>
  <button type="button" class="chip sub" data-parent="Experimental">Deconstructed Club</button>

  <!-- HIP-HOP -->
  <button type="button" class="chip sub" data-parent="Hip-Hop">Boom Bap</button>
  <button type="button" class="chip sub" data-parent="Hip-Hop">Cloud Rap</button>
  <button type="button" class="chip sub" data-parent="Hip-Hop">Underground</button>
  <button type="button" class="chip sub" data-parent="Hip-Hop">Conscious Rap</button>

  <!-- R&B -->
  <button type="button" class="chip sub" data-parent="R&B">Alt R&B</button>
  <button type="button" class="chip sub" data-parent="R&B">Neo Soul</button>
  <button type="button" class="chip sub" data-parent="R&B">Contemporary R&B</button>

  <!-- ROCK -->
  <button type="button" class="chip sub" data-parent="Rock">Post Punk</button>
  <button type="button" class="chip sub" data-parent="Rock">Shoegaze</button>
  <button type="button" class="chip sub" data-parent="Rock">Garage Rock</button>

  <!-- JAZZ -->
  <button type="button" class="chip sub" data-parent="Jazz">Jazz Fusion</button>
  <button type="button" class="chip sub" data-parent="Jazz">Nu Jazz</button>
  <button type="button" class="chip sub" data-parent="Jazz">Lo-fi Jazz</button>

  <!-- SOUL -->
  <button type="button" class="chip sub" data-parent="Soul">Neo Soul</button>
  <button type="button" class="chip sub" data-parent="Soul">Funk</button>

  <!-- AFRO -->
  <button type="button" class="chip sub" data-parent="Afro">Afrobeats</button>
  <button type="button" class="chip sub" data-parent="Afro">Amapiano</button>

  <!-- LATINO -->
  <button type="button" class="chip sub" data-parent="Latino">Corridos</button>
  <button type="button" class="chip sub" data-parent="Latino">Regional Mexicano</button>
  <button type="button" class="chip sub" data-parent="Latino">Latin Pop</button>
  <button type="button" class="chip sub" data-parent="Latino">Reggaeton Mexa</button>

  <!-- CLUB -->
  <button type="button" class="chip sub" data-parent="Club">Club</button>
  <button type="button" class="chip sub" data-parent="Club">Hardgroove</button>
  <button type="button" class="chip sub" data-parent="Club">Baile Funk</button>
  <button type="button" class="chip sub" data-parent="Club">Ghetto Tech</button>

  <!-- AMBIENT -->
  <button type="button" class="chip sub" data-parent="Ambient">Ambient</button>
  <button type="button" class="chip sub" data-parent="Ambient">Drone</button>
  <button type="button" class="chip sub" data-parent="Ambient">Soundscape</button>

  <!-- FOLK -->
  <button type="button" class="chip sub" data-parent="Folk">Indie Folk</button>
  <button type="button" class="chip sub" data-parent="Folk">Acoustic</button>

  <!-- GLOBAL -->
  <button type="button" class="chip sub" data-parent="Global">World</button>
  <button type="button" class="chip sub" data-parent="Global">Fusion</button>

</div>

  <input type="hidden" name="genre" id="genreInput" />

</div>

  <!-- 🎨 PROYECTO -->
  <div>
    <label class="label">Cuéntanos sobre tu proyecto</label>
    <textarea 
      name="message" 
      rows="4" 
      class="input"
      placeholder="Describe tu sonido, referencias o lo que hace único tu proyecto"
    ></textarea>
  </div>

  <!-- 🌍 CONTEXTO -->
  <div>
    <label class="label">Ciudad / país</label>
    <input 
      name="location" 
      class="input" 
      placeholder="Monterrey, MX"
    />
  </div>

  <div>
    <label class="label">Instagram</label>
    <input 
      name="instagram" 
      class="input" 
      placeholder="@usuario"
    />
  </div>

  <!-- ⚠️ DISCLAIMER -->
  <p class="text-xs text-base-content/40 leading-relaxed max-w-md">
    Recibimos muchos envíos. Solo contactamos proyectos alineados con nuestra línea curatorial.
  </p>

<label class="text-xs opacity-60 flex gap-2 mt-4 items-start">
  <input type="checkbox" required class="mt-1" />

  <span>
    Acepto los 
    <a href="/terminos" target="_blank" class="underline hover:text-accent">
      términos y condiciones
    </a>
    y el 
    <a href="/privacidad" target="_blank" class="underline hover:text-accent">
      aviso de privacidad
    </a>
  </span>
</label>

  <!-- 🚀 CTA -->
  <button 
  id="btn-submit"
    type="submit" 
    class="btn-tactical px-6 py-3 self-start flex items-center gap-3"
  >
    <span class="btn-text">Enviar para revisión</span>

    <span class="btn-loader hidden-custom w-4 h-4 border-2 border-base-content/30 border-t-white rounded-full animate-spin"></span>
  </button>

</form>
</section>

<Footer />

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {

  const form = document.getElementById("submitForm");
  if (!form) return;

  const submitBtn = form.querySelector("#btn-submit");
  const inputs = form.querySelectorAll(
    'input[name="artist"], input[name="email"], input[name="spotify"], textarea[name="message"], input[name="location"], input[name="instagram"]'
  );

  const genreInput = document.getElementById("genreInput");
  const termsCheckbox = form.querySelector('input[type="checkbox"]');

  const mainChips = document.querySelectorAll("#mainGenres .chip");
  const subChips = document.querySelectorAll("#subGenres .chip");
  const subContainer = document.getElementById("subGenres");
  const subLabel = document.getElementById("subLabel");

  let selectedMain = null;
  let selectedSub = null;

  // 🔒 iniciar deshabilitado
  submitBtn.disabled = true;
  submitBtn.classList.add("opacity-50", "cursor-not-allowed");

  // 🎧 MAIN GENRE
  mainChips.forEach(chip => {
    chip.addEventListener("click", () => {

      if (chip.classList.contains("active")) {
        chip.classList.remove("active");
        selectedMain = null;

        selectedSub = null;
        subContainer.classList.add("hidden-custom");
        subLabel.classList.add("hidden-custom");

        subChips.forEach(c => c.classList.remove("active"));

        updateInput();
        validateForm();
        return;
      }

      mainChips.forEach(c => c.classList.remove("active"));
      chip.classList.add("active");

      selectedMain = chip.textContent;

      subContainer.classList.remove("hidden-custom");
      subLabel.classList.remove("hidden-custom");

      selectedSub = null;

      subChips.forEach(c => {
        c.classList.remove("active");
        c.style.display =
          c.dataset.parent === selectedMain ? "inline-flex" : "none";
      });

      updateInput();
      validateForm();
    });
  });

  // 🎛️ SUBGENRE
  subChips.forEach(chip => {
    chip.addEventListener("click", () => {

      if (chip.classList.contains("active")) {
        chip.classList.remove("active");
        selectedSub = null;
        updateInput();
        validateForm();
        return;
      }

      subChips.forEach(c => c.classList.remove("active"));
      chip.classList.add("active");

      selectedSub = chip.textContent;

      updateInput();
      validateForm();
    });
  });

  // 🔍 actualizar input hidden
  function updateInput() {
    if (!selectedMain) {
      genreInput.value = "";
      return;
    }

    genreInput.value = selectedSub
      ? `${selectedMain} → ${selectedSub}`
      : selectedMain;
  }

  // ✅ VALIDACIÓN COMPLETA
  function validateForm() {
    let valid = true;

    // inputs
    inputs.forEach((input) => {
      if (!input.value.trim()) {
        valid = false;
      }
    });

    // género
    if (!genreInput.value.trim()) {
      valid = false;
    }

    // 🔥 checkbox legal
    if (!termsCheckbox.checked) {
      valid = false;
    }

    // estado botón
    if (valid) {
      submitBtn.disabled = false;
      submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
    } else {
      submitBtn.disabled = true;
      submitBtn.classList.add("opacity-50", "cursor-not-allowed");
    }
  }

  // 👂 listeners inputs
  inputs.forEach((input) => {
    input.addEventListener("input", validateForm);
  });

  // 👂 checkbox
  termsCheckbox.addEventListener("change", validateForm);

  // init
  validateForm();
});
</script>

<script>
  import "../scripts/submit.js";
</script>