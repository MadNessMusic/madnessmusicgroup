---
export const revalidate = 60;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Highlights from "../components/Highlights.astro";
import Playlists from "../components/Playlists.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import About from "../components/About.astro";
import MadNessReleases from "../components/MadNessReleases.astro";
import { releases } from "../data/releases.ts";
---

<Layout title="Inicio">
  
  <Navbar />

  <main>
    <Hero />

    <About />
    <MadNessReleases releases={releases} />

    <Playlists />

    <Contact />

  </main>
  <Footer />
</Layout>